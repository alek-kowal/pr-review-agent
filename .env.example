# Local Docker Compose db (`docker compose up -d db`, non-secret): postgres://pra:pra@localhost:5432/pra
DATABASE_URL=
# Model access, one of the two (the subscription wins when both are set):
# a Claude subscription token from `claude setup-token`, or a pay-per-token API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional: the judge on an OpenRouter model (`openrouter/<vendor>/<model>` in Settings → Models).
# Without it an OpenRouter judge falls back to the Claude judge.
OPENROUTER_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
CLICKUP_API_KEY=
# Default .data/blobs; relative paths count from the repo root
BLOB_DIR=
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SENTRY_DSN=
# Sentry environment (default NODE_ENV) and release, used only with SENTRY_DSN
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Address people open the app at (local: the web dev server). Alert comments in ClickUp link to
# <APP_BASE_URL>/pr/<repo>/<number>; without it alerts show "Not sent: ClickUp not configured"
APP_BASE_URL=
# api: proxies whose X-Forwarded-* headers count (comma-separated IPs/CIDRs); unset = none
TRUST_PROXY=
SANDBOX_DOCKER_HOST=
# Worker limits (P-27, docs/deploy-mikrus.md). Unset = the default in brackets.
# Stage jobs at once; keep it >= Settings' agent slots [3]
WORKER_AGENT_CONCURRENCY=
# Sandbox containers at once, every caller (install, reproductions) [1]
WORKER_SANDBOX_CONCURRENCY=
# Per sandbox container: CPUs (capped at the host's) [1], memory in MB [2048], processes [1024]
SANDBOX_CPUS=
SANDBOX_MEMORY_MB=
SANDBOX_PIDS=
# Time limits in minutes: fetch step [10], install step [15], one reproduction [5]
SANDBOX_FETCH_TIMEOUT_MINUTES=
SANDBOX_INSTALL_TIMEOUT_MINUTES=
SANDBOX_REPRO_TIMEOUT_MINUTES=
# auto (gVisor when the daemon has it), runc or runsc [auto]
SANDBOX_RUNTIME=
# Hardlink the repository's pnpm store into installs; false = copy packages [true]
SANDBOX_SHARED_STORE=
# Worker: git mirrors and review session files. Default .data; relative paths count from the repo root
DATA_DIR=
# Worker only, set by deploy/compose.yaml: file the container healthcheck reads
WORKER_HEARTBEAT_FILE=
# Tests only: MinIO for the S3 BlobStore tests (CI sets it); unset = the local pra-minio-1 port
S3_TEST_ENDPOINT=
