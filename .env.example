# Local Docker Compose db (`docker compose up -d db`, non-secret): postgres://pra:pra@localhost:5432/pra
DATABASE_URL=
ANTHROPIC_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
CLICKUP_API_KEY=
# Default .data/blobs; relative paths count from the repo root
BLOB_DIR=
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_BASE_URL=
SANDBOX_DOCKER_HOST=
# Worker only, set by deploy/compose.yaml: file the container healthcheck reads
WORKER_HEARTBEAT_FILE=
