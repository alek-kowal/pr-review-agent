{
  "name": "@pra/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "scripts": {
    "dev": "fastify start -w -l info src/app.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "fastify start -l info dist/app.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/autoload": "^6.6.0",
    "@fastify/sensible": "^6.0.8",
    "@fastify/swagger": "^9.9.5",
    "fastify": "^5.12.8",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
