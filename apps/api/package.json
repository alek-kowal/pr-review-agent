{
  "name": "@pra/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PR Review Agent HTTP api (Fastify).",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/autoload": "^6.6.0",
    "@fastify/sensible": "^6.0.8",
    "@fastify/swagger": "^9.9.5",
    "@pra/db": "workspace:*",
    "@pra/integrations": "workspace:*",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
