# Serves the SPA and forwards the api paths to the api container. TLS and the access gate sit in
# front of this (F-04-T7), so Caddy here speaks plain HTTP on :8080.
{
	admin off
	auto_https off
}

:8080 {
	@api path /api/* /webhooks/* /health
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			# Stream responses as they come (server-sent events from S-03 on).
			flush_interval -1
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
