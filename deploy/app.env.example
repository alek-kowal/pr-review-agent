# deploy/app.env: written by the secret store on the VM, never committed. Names only here.
# Read by api, worker and migrate (deploy/compose.yaml); `web` gets none of it.
DATABASE_URL=
ANTHROPIC_API_KEY=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
CLICKUP_API_KEY=
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_BASE_URL=
# api: proxies whose X-Forwarded-* headers count (comma-separated IPs/CIDRs); unset = none
TRUST_PROXY=
# GITHUB_APP_PRIVATE_KEY_PATH is set by compose.yaml (the mounted secret). The host path of the
# key file goes in GITHUB_APP_PRIVATE_KEY_FILE, in the shell or deploy/.env, not here.
