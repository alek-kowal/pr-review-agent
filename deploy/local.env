# App env for the `local` profile rehearsal (PRA_ENV_FILE=local.env). Local, non-secret values
# for the throwaway Postgres and MinIO in compose.yaml; no real keys.
DATABASE_URL=postgres://pra:pra@postgres:5432/pra
S3_BUCKET=pra
S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=pra
AWS_SECRET_ACCESS_KEY=pra-local-only
AWS_REGION=us-east-1
APP_BASE_URL=http://localhost:8080
