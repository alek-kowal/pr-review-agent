# Copy to deploy/mikrus/deploy.env (gitignored) on the machine you deploy from. Names only here.
# SSH host of the VPS (Mikrus: the srvNN host from the panel)
PRA_DEPLOY_HOST=
# SSH port (Mikrus: the port from the panel) [22]
PRA_DEPLOY_PORT=
# User on the VPS that owns /srv/pra [pra]
PRA_DEPLOY_USER=
# SSH identity file for that user (optional; no spaces in the path)
PRA_DEPLOY_KEY=
# Bare repository on the VPS [/srv/pra/repo.git]
PRA_DEPLOY_REPO=
