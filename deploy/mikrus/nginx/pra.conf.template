# PR Review Agent on the Mikrus VPS (P-27). The Mikrus proxy terminates TLS for
# https://${PRA_SERVER_NAME} and forwards plain HTTP to this nginx on :80, picking the site by
# server_name. Install (bootstrap.md):
#   PRA_SERVER_NAME=<subdomain>.mikrus.dev envsubst '${PRA_SERVER_NAME}' \
#     < deploy/mikrus/nginx/pra.conf.template > /etc/nginx/sites-available/pra.conf
server {
    listen 80;
    listen [::]:80;
    server_name ${PRA_SERVER_NAME};
    server_tokens off;

    # The SPA build deploy.sh switches to (a link to web/releases/<commit>).
    root /srv/pra/web/current;
    index index.html;

    # The access gate: one shared login (htpasswd) for everything except GitHub's deliveries.
    auth_basic "PR Review Agent";
    auth_basic_user_file /etc/nginx/pra.htpasswd;

    client_max_body_size 1m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # Overwrites whatever the client sent; the api trusts it from loopback only (TRUST_PROXY)
    # and its CSRF check compares Origin with this host.
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # The gate's credentials stay here; the api never sees or logs them.
    proxy_set_header Authorization "";

    # GitHub cannot send the gate's login; each delivery is signed (GITHUB_WEBHOOK_SECRET) and the
    # api checks the signature. Payloads go up to 25 MB.
    location = /webhooks/github {
        auth_basic off;
        client_max_body_size 25m;
        proxy_pass http://127.0.0.1:3000;
    }

    # Server-sent events: pass each event on at once and keep the stream open.
    location = /api/live {
        proxy_pass http://127.0.0.1:3000;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
    }

    location /webhooks/ {
        proxy_pass http://127.0.0.1:3000;
    }

    location = /health {
        proxy_pass http://127.0.0.1:3000;
    }

    # Hashed file names: cache for a year.
    location /assets/ {
        expires max;
        try_files $uri =404;
    }

    # Client-side routes fall back to the SPA; index.html is never cached.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
