# /etc/pra/pra.env on the VPS (P-27): root:pra, mode 0640. Names only here; the values go only
# into that file. systemd reads it for api, worker and cleanup, and the checkout's `.env` is a
# link to it, so `pnpm db:migrate`, `pnpm data:cleanup` and `pnpm sandbox:bench` see the same
# settings. Plain KEY=value lines, no quotes, no `export`. Every name is described in the root
# .env.example; the units set NODE_ENV, HOST, PORT, TRUST_PROXY and WORKER_HEARTBEAT_FILE.

# postgres://pra:<POSTGRES_PASSWORD from /etc/pra/db.env>@127.0.0.1:5432/pra
DATABASE_URL=
# https://<subdomain>.mikrus.dev (Needs Alek: the subdomain)
APP_BASE_URL=

# Model access: the subscription token from `claude setup-token` (or ANTHROPIC_API_KEY)
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# GitHub App; the key file at /etc/pra/github-app.pem (root:pra, 0640). Leave all three empty
# until the App exists: the worker then polls GitHub read-only (P-28).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Optional while polling: fine-grained token, "Public repositories (read-only)"; without it 60/h
GITHUB_TOKEN=
CLICKUP_API_KEY=

# Absolute paths on the data disk: /var/lib/pra/data and /var/lib/pra/blobs
DATA_DIR=
BLOB_DIR=

SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Worker limits for 1 vCPU / 4 GB (defaults fit; see docs/deploy-mikrus.md before changing)
WORKER_AGENT_CONCURRENCY=
WORKER_SANDBOX_CONCURRENCY=
SANDBOX_CPUS=
SANDBOX_MEMORY_MB=
SANDBOX_PIDS=
SANDBOX_FETCH_TIMEOUT_MINUTES=
SANDBOX_INSTALL_TIMEOUT_MINUTES=
SANDBOX_REPRO_TIMEOUT_MINUTES=
# runc on Mikrus: gVisor (runsc) fails in its unprivileged LXC (docs/deploy-mikrus.md)
SANDBOX_RUNTIME=
SANDBOX_SHARED_STORE=
