{
  "name": "pr-review-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "echo 'test:e2e: Playwright arrives in F-01-T7' && exit 1",
    "verify": "pnpm run \"/^(lint|typecheck|test)$/\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
