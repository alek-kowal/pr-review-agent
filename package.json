{
  "name": "pr-review-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "echo 'lint: ESLint and Prettier arrive in F-01-T6'",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "echo 'test:e2e: Playwright arrives in F-01-T7' && exit 1",
    "verify": "pnpm run \"/^(lint|typecheck|test)$/\""
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
