{
  "name": "pr-review-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm run \"/^(lint|typecheck|test)$/\"",
    "db:generate": "pnpm --filter @pra/db db:generate",
    "db:migrate": "node --env-file-if-exists=.env packages/db/src/cli/migrate.ts",
    "db:seed-repo": "node --env-file-if-exists=.env packages/db/src/cli/seed-repo.ts",
    "instructions:import": "node --env-file-if-exists=.env packages/db/src/cli/instructions-import.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@pra/agents": "workspace:*",
    "@pra/db": "workspace:*",
    "@pra/integrations": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
