{
  "name": "pr-review-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm run \"/^(lint|typecheck|test)$/\"",
    "db:generate": "pnpm --filter @pra/db db:generate",
    "db:migrate": "node --env-file-if-exists=.env packages/db/src/cli/migrate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "catalog:",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
