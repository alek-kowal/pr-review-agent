{
  "repository": {
    "slug": "workflowbuilder",
    "githubFullName": "synergycodes/workflowbuilder",
    "defaultBranch": "main",
    "defaultLevel": 1,
    "fetchCommand": "pnpm fetch --frozen-lockfile --ignore-scripts --ignore-pnpmfile",
    "installCommand": "pnpm install --offline --frozen-lockfile",
    "sensitivePatterns": [
      {
        "pattern": "packages/(sdk|ui|temporal)/src/index.ts",
        "reason": "Public exports: the published API of a package."
      },
      {
        "pattern": "packages/*/package.json",
        "reason": "Package manifests of published packages."
      },
      {
        "pattern": "packages/temporal/src/workflow/",
        "reason": "Temporal workflow code must replay older histories."
      },
      {
        "pattern": "apps/backend/drizzle/",
        "reason": "Database migrations cannot be undone after deploy."
      },
      {
        "pattern": "deploy/",
        "reason": "Production deployment files."
      },
      {
        "pattern": ".github/workflows/",
        "reason": "CI and release workflows."
      },
      {
        "pattern": "CLAUDE.md",
        "reason": "Instructions that agents follow in this repository."
      },
      {
        "pattern": ".claude/",
        "reason": "Agent commands and settings."
      }
    ],
    "changeTypeRules": {
      "usesExistingPaths": [
        "**/*.md",
        "**/*.mdx",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**",
        "**/e2e/**",
        "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
        ".changeset/**",
        "apps/docs/**",
        "apps/e2e/**"
      ],
      "oneWayPaths": [
        "apps/backend/drizzle/**",
        "packages/*/src/index.ts",
        "deploy/**"
      ],
      "sizeLines": 800
    },
    "largePrLines": 1500
  },
  "instructions": {
    "global": [
      "prompt-reviewer.md",
      "review-rules.md",
      "prompt-classifier.md",
      "classify-rules.md",
      "prompt-verifier.md",
      "verify-rules.md",
      "prompt-implementer.md",
      "implement-rules.md"
    ],
    "repository": [
      "lessons.md",
      "feature-map/"
    ]
  }
}
